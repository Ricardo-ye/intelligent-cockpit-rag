# ─────────────────────────────────────────────
# 智能座舱 RAG 评估系统 —— 环境变量样例
# 用法：复制为 .env 并填入真实 Key。app 启动时自动加载，也可直接在侧边栏输入。
# ─────────────────────────────────────────────

# 【生成模型 / LLM 判官指标】DeepSeek（OpenAI 兼容）
# 用于：答案生成、忠实度核查、答案相关性反推、LLM 重排、上下文压缩
DEEPSEEK_API_KEY=

# 【可选】自定义 OpenAI 兼容服务（中转站 / 自建 / 其他厂商）
# 若使用「自定义 OpenAI 兼容」后端，需同时配置下面两项
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 【可选】Embedding 接口（注意：DeepSeek 官方不提供 embedding 接口）
# 不配置时，向量化默认使用本地 TF-IDF + SVD，完全离线、真实可算
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
